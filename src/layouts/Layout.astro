---
import '../styles/global.css';
import BackToTop from '../components/BackToTop';
import Background from '../components/Background';
import LoadingScreen from '../components/LoadingScreen.astro';
import SpotlightLens from '../components/SpotlightLens';
import Analytics from '@vercel/analytics/astro';
import SEO from '../components/SEO.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article' | 'profile';
}

const { 
	title = "Cris Charles Garcia | Full-Stack Developer Portfolio", 
	description = "Personal portfolio website of Cris Charles Garcia, showcasing projects, skills, experience, and custom AI chatbot assistant.",
	image = "/logo.png",
	type = "website"
} = Astro.props;

const isRootPage = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO & Structured Data -->
		<SEO title={title} description={description} image={image} type={type} />
		
		<!-- Theme Initialization Script (Prevents FOUC) -->
		<script is:inline>
			(function() {
				const storedTheme = localStorage.getItem('theme');
				if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>
	</head>
	<body class="bg-background-custom text-foreground-custom bg-gradient-mesh min-h-screen flex flex-col selection:bg-primary-custom/30">
		<LoadingScreen />
		<Background client:load />
		<div id="magnify-content">
			<div class="hidden glass-card glass-nav text-glow glow-effect reveal-fade-up reveal-fade-down reveal-fade-left reveal-fade-right reveal-scale-up"></div>
			<slot />
		</div>
		<BackToTop client:idle />
		<SpotlightLens client:load />
        <Analytics />
	</body>
</html>
