---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BackToTop from '../components/BackToTop';
import Background from '../components/Background';
import SpotlightLens from '../components/SpotlightLens';
import PortfolioAssistantFAB from '../components/PortfolioAssistantFAB';
import Analytics from '@vercel/analytics/astro';
import SEO from '../components/SEO.astro';
import NetworkStatus from '../components/NetworkStatus';
import LagNotification from '../components/LagNotification';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article' | 'profile';
}

const { 
	title = "Cris Charles Garcia | Full-Stack Developer Portfolio", 
	description = "Personal portfolio website of Cris Charles Garcia, showcasing projects, skills, experience, and custom AI chatbot assistant.",
	image = "/logo.png",
	type = "website"
} = Astro.props;

const isRootPage = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<!-- PWA & Mobile Web App Manifest -->
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#090a0f" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Cris Charles" />

		<!-- SEO & Structured Data -->
		<SEO title={title} description={description} image={image} type={type} />
		
		<!-- FontAwesome 6 Icons -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

		<!-- Astro ClientRouter for seamless SPA page transitions (no reload, no twitch) -->
		<ClientRouter />
		
		<!-- Theme Initialization Script (Prevents FOUC & preserves theme on Astro transitions) -->
		<script is:inline>
			(function() {
				function getResolvedTheme() {
					var storedTheme = localStorage.getItem('theme');
					if (storedTheme === 'light') return 'light';
					if (storedTheme === 'dark') return 'dark';
					if (storedTheme === 'system') {
						return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					}
					// Default: dark mode signature theme
					return 'dark';
				}

				function applyTheme(doc) {
					var targetDoc = doc || document;
					var theme = getResolvedTheme();
					var metaThemeColor = targetDoc.querySelector('meta[name="theme-color"]');
					if (theme === 'dark') {
						targetDoc.documentElement.classList.add('dark');
						if (metaThemeColor) metaThemeColor.setAttribute('content', '#090a0f');
					} else {
						targetDoc.documentElement.classList.remove('dark');
						if (metaThemeColor) metaThemeColor.setAttribute('content', '#fafafa');
					}
				}

				applyTheme(document);

				// Crucial for Astro ClientRouter: re-apply theme on before-swap, after-swap and page-load
				document.addEventListener('astro:before-swap', function(e) {
					if (e.newDocument) applyTheme(e.newDocument);
				});
				document.addEventListener('astro:after-swap', function() {
					applyTheme(document);
				});
				document.addEventListener('astro:page-load', function() {
					applyTheme(document);
				});

				// Automatically adapt if user explicitly selected system
				try {
					var darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
					var listener = function(e) {
						var stored = localStorage.getItem('theme');
						if (stored === 'system') {
							applyTheme(document);
							window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: e.matches ? 'dark' : 'light' } }));
						}
					};
					if (darkQuery.addEventListener) {
						darkQuery.addEventListener('change', listener);
					} else if (darkQuery.addListener) {
						darkQuery.addListener(listener);
					}
				} catch (err) {
					// Ignore older browser issues
				}
			})();
		</script>

		<!-- Orientation Stamp Script (Prevents nav layout shift) -->
		<script is:inline>
			(function() {
				function setOrientation(doc) {
					var targetDoc = doc || document;
					const isPortrait = window.matchMedia('(orientation: portrait)').matches;
					const isNarrowLandscape = !isPortrait && window.innerWidth < 1024;
					targetDoc.documentElement.dataset.orientation = isPortrait
						? 'portrait'
						: isNarrowLandscape
							? 'landscape-compact'
							: 'landscape';
				}
				setOrientation(document);
				window.addEventListener('resize', function() { setOrientation(document); }, { passive: true });
				window.addEventListener('orientationchange', function() { setOrientation(document); }, { passive: true });
				document.addEventListener('astro:before-swap', function(e) {
					if (e.newDocument) setOrientation(e.newDocument);
				});
				document.addEventListener('astro:after-swap', function() {
					setOrientation(document);
				});
			})();
		</script>
		<!-- Performance Tier, Ultra-Fast Design & Lite Mode Detection (Persists across all page transitions) -->
		<script is:inline>
			(function() {
				function applyTier(doc) {
					var targetDoc = doc || document;
					var manualLite = localStorage.getItem('liteMode');
					var tier = 'mid';
					if (manualLite === 'true') {
						tier = 'low';
					} else {
						// Lite mode default is disabled (Off) unless explicitly enabled by user
						var cores = navigator.hardwareConcurrency || 4;
						if (cores >= 8 && window.devicePixelRatio >= 2) {
							tier = 'high';
						} else {
							tier = 'mid';
						}
					}
					targetDoc.documentElement.dataset.tier = tier;
					return tier;
				}

				function applyFontZoom(doc) {
					var targetDoc = doc || document;
					var savedZoom = localStorage.getItem('pageZoom');
					if (savedZoom) {
						var zoomVal = parseInt(savedZoom, 10);
						if (!isNaN(zoomVal) && zoomVal >= 80 && zoomVal <= 130) {
							targetDoc.documentElement.style.fontSize = ((zoomVal / 100) * 15) + 'px';
						}
					}
				}

				function initPreferences(doc) {
					var targetDoc = doc || document;
					var tier = applyTier(targetDoc);
					applyFontZoom(targetDoc);
					return tier;
				}

				initPreferences(document);

				// Crucial for Astro ClientRouter: Apply to e.newDocument BEFORE swap to prevent attribute loss
				document.addEventListener('astro:before-swap', function(e) {
					if (e.newDocument) {
						initPreferences(e.newDocument);
					}
				});

				// Ensure Ultra-Fast Design & Zoom persist across ALL pages during client router transitions
				document.addEventListener('astro:after-swap', function() {
					var tier = initPreferences(document);
					window.dispatchEvent(new CustomEvent('tier-change', { detail: { tier: tier } }));
				});
				document.addEventListener('astro:page-load', function() {
					var tier = initPreferences(document);
					window.dispatchEvent(new CustomEvent('tier-change', { detail: { tier: tier } }));
				});
			})();
		</script>

		<!-- Service Worker Registration for PWA & Offline E-Business Card -->
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', function() {
					navigator.serviceWorker.register('/sw.js').catch(function(err) {
						console.log('SW registration error:', err);
					});
				});
			}
		</script>
	</head>
	<body class="bg-background-custom text-foreground-custom bg-gradient-mesh min-h-screen flex flex-col selection:bg-primary-custom/30">
		<Background client:load transition:persist="main-bg" />
		<div id="magnify-content" class="w-full max-w-full min-h-screen flex flex-col pt-[60px] md:pt-0 md:pl-64 overflow-x-clip">
			<div class="hidden glass-card glass-nav text-glow glow-effect reveal-fade-up reveal-fade-down reveal-fade-left reveal-fade-right reveal-scale-up"></div>
			<slot />
		</div>
		<BackToTop client:idle transition:persist="back-to-top" />
		<PortfolioAssistantFAB client:idle transition:persist="portfolio-assistant" />
		<SpotlightLens client:load transition:persist="spotlight-lens" />
		<NetworkStatus client:load transition:persist="network-status" />
		<LagNotification client:load transition:persist="lag-notification" />
        <Analytics />
	</body>
</html>
