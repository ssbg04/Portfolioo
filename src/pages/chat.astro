---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ChatWidget from '../components/ChatWidget';
import { getSiteSettings } from '../lib/data';

const settings = await getSiteSettings();
---

<Layout title={`AI Chat | ${settings.fullName}`} description="Converse with Cris Charles Garcia's AI Assistant to learn about skills, projects, and work history.">
	<Navbar client:load />

	<main class="flex-1 pt-32 pb-24 flex flex-col items-center justify-center min-h-[85vh] px-4">
		<div class="text-center mb-8">
			<h1 class="text-3xl md:text-5xl font-bold font-heading mb-2 text-glow bg-clip-text text-transparent bg-gradient-to-r from-foreground-custom to-primary-custom">
				AI Assistant
			</h1>
			<p class="text-muted-foreground-custom text-xs max-w-sm mx-auto">
				Have questions about Cris's resume or project work? Ask my automated digital twin!
			</p>
		</div>
		<ChatWidget client:load />
	</main>

	<footer class="py-12 border-t border-border/10 text-center text-xs text-muted-foreground-custom relative z-10 bg-muted-custom/5">
		<p>&copy; {new Date().getFullYear()} {settings.fullName}. Built with Astro & React. All rights reserved.</p>
	</footer>
</Layout>
