---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ChatWidget from '../components/ChatWidget';
import Footer from '../components/Footer';
import { getSiteSettings, getSocialLinks } from '../lib/data';

const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();
---

<Layout 
	title={settings.seoTitle ? `AI Chat | ${settings.seoTitle}` : `AI Chat | ${settings.fullName}`} 
	description="Converse with Cris Charles Garcia's AI Assistant to learn about skills, projects, and work history."
	image={settings.heroImage || settings.logoImage || '/logo.png'}
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} client:load />

	<main class="flex-1 pt-32 pb-24 flex flex-col items-center justify-center min-h-[85vh] px-4">
		<div class="text-center mb-8">
			<h1 class="text-3xl md:text-5xl font-bold font-heading mb-2 text-glow bg-clip-text text-transparent bg-gradient-to-r from-foreground-custom to-primary-custom">
				AI Assistant
			</h1>
			<p class="text-muted-foreground-custom text-xs max-w-sm mx-auto">
				Have questions about Cris's resume or project work? Ask my automated digital twin!
			</p>
		</div>
		<ChatWidget client:load />
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
