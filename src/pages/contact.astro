---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ContactForm from '../components/ContactForm';
import VisitorWorldMap from '../components/VisitorWorldMap';
import LiveChatBox from '../components/LiveChatBox';
import Footer from '../components/Footer';
import { getSiteSettings, getSocialLinks } from '../lib/data';

const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();
---

<Layout 
	title={settings.seoTitle ? `Contact | ${settings.seoTitle}` : `Contact | ${settings.fullName}`} 
	description="Get in touch with Cris Charles Garcia for opportunities, consulting, or project collaborations."
	image={settings.heroImage || settings.logoImage || '/logo.png'}
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} currentPath={Astro.url.pathname} client:load transition:persist="main-navbar" />

	<main class="flex-1 pt-6 sm:pt-10 pb-16">
		<div class="max-w-[56rem] mx-auto px-4 sm:px-6 mb-8 pb-5 border-b border-border-custom">
			<span class="section-marker mb-1 block">06 — communication</span>
			<h1 class="font-display text-3xl sm:text-4xl tracking-tight text-foreground-custom lowercase">
				contact &amp; interaction
			</h1>
			<p class="text-xs font-mono text-muted-foreground-custom mt-2">
				direct engineering inquiries, project discussions, and live visitor telemetry
			</p>
			
			{/* Technical Detail Badges */}
			<div className="flex flex-wrap items-center gap-2 mt-4 pt-3 border-t border-border-custom">
				<span className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground-custom px-2.5 py-1 rounded-full border border-border-custom bg-elevated-custom">
					response: 24–48 hours
				</span>
				<span className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground-custom px-2.5 py-1 rounded-full border border-border-custom bg-elevated-custom">
					{settings.location || 'laguna, ph (utc+8)'}
				</span>
				{settings.isAvailable !== false && (
					<span className="chip-inverted text-[10px] py-0.5 px-2.5">
						● open to opportunities
					</span>
				)}
			</div>
		</div>

		{/* ── Real-Time Presence: Full-Width Global Visitor Radar ── */}
		<div class="max-w-[56rem] mx-auto px-4 sm:px-6 mb-10 sm:mb-14">
			<VisitorWorldMap client:load />
		</div>

		{/* ── Direct Interaction: Live Telegram Desk ── */}
		<div class="max-w-[56rem] mx-auto px-4 sm:px-6 mb-12 sm:mb-16">
			<div class="flex items-center justify-between mb-3 px-1">
				<div class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-foreground-custom animate-pulse" />
					<span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground-custom">
						instant live desk // mobile push
					</span>
				</div>
				<span class="text-[10px] font-mono text-subtle-custom hidden sm:inline">
					replies directly to visitor session
				</span>
			</div>
			<LiveChatBox client:load />
		</div>

		<ContactForm 
			socialLinks={socialLinks}
			contactHeading={settings.contactHeading}
			contactSubtitle={settings.contactSubtitle}
			email={settings.email}
			sectionTag="direct outreach"
			client:load 
		/>
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
