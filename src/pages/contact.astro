---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ContactForm from '../components/ContactForm';
import Footer from '../components/Footer';
import { getSiteSettings, getSocialLinks } from '../lib/data';

const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();
---

<Layout 
	title={settings.seoTitle ? `Contact | ${settings.seoTitle}` : `Contact | ${settings.fullName}`} 
	description="Get in touch with Cris Charles Garcia for opportunities, consulting, or project collaborations."
	image={settings.heroImage || settings.logoImage || '/logo.png'}
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} currentPath={Astro.url.pathname} client:load transition:persist="main-navbar" />

	<main class="flex-1 pt-2 sm:pt-6 pb-16">
		<ContactForm 
			socialLinks={socialLinks}
			contactHeading={settings.contactHeading}
			contactSubtitle={settings.contactSubtitle}
			email={settings.email}
			client:load 
		/>
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
