---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ContactForm from '../components/ContactForm';
import Footer from '../components/Footer';
import { getSiteSettings, getSocialLinks } from '../lib/data';

const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();
---

<Layout 
	title={settings.seoTitle ? `Contact | ${settings.seoTitle}` : `Contact | ${settings.fullName}`} 
	description="Get in touch with Cris Charles Garcia for opportunities, consulting, or project collaborations."
	image={settings.heroImage || settings.logoImage || '/logo.png'}
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} currentPath={Astro.url.pathname} client:load transition:persist="main-navbar" />

	<main class="flex-1 pt-4 sm:pt-8 pb-16">
		<div class="container mx-auto px-4 sm:px-6 max-w-6xl text-center mb-6 sm:mb-10">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium tracking-wider bg-primary-custom/10 text-primary-custom border border-primary-custom/20 mb-3">
				<span>Get In Touch</span>
			</div>
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-heading tracking-tight text-foreground-custom">
				Contact &amp; Collaboration
			</h1>
			<p class="text-sm sm:text-base text-muted-foreground-custom mt-3 max-w-xl mx-auto leading-relaxed">
				Have an upcoming project, software development inquiry, or technical opportunity? Feel free to send a direct message, reach out via email, or connect on my active platforms.
			</p>
			
			{/* Standalone Quick Details Badges */}
			<div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mt-5">
				<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-mono bg-card-custom border border-border-custom shadow-xs text-foreground-custom">
					<svg class="w-3.5 h-3.5 text-primary-custom" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
					<span>Response: 24–48 Hours</span>
				</span>
				<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-mono bg-card-custom border border-border-custom shadow-xs text-foreground-custom">
					<svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path strokeLinecap="round" strokeLinejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
					<span>{settings.location || 'Laguna, Philippines (PHT, UTC+8)'}</span>
				</span>
				{settings.isAvailable !== false && (
					<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-mono bg-card-custom border border-border-custom shadow-xs text-foreground-custom font-medium">
						<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
						<span>{settings.availabilityStatus || 'Open to Opportunities'}</span>
					</span>
				)}
			</div>
		</div>

		<ContactForm 
			socialLinks={socialLinks}
			contactHeading={settings.contactHeading}
			contactSubtitle={settings.contactSubtitle}
			email={settings.email}
			client:load 
		/>
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
