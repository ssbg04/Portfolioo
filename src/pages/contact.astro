---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ContactForm from '../components/ContactForm';
import { getSiteSettings } from '../lib/data';

const settings = await getSiteSettings();
---

<Layout title={`Contact | ${settings.fullName}`} description="Get in touch with Cris Charles Garcia for opportunities, consulting, or project collaborations.">
	<Navbar client:load />

	<main class="flex-1 pt-32 pb-24">
		<ContactForm client:load />
	</main>

	<footer class="py-12 border-t border-border/10 text-center text-xs text-muted-foreground-custom relative z-10 bg-muted-custom/5">
		<p>&copy; {new Date().getFullYear()} {settings.fullName}. Built with Astro & React. All rights reserved.</p>
	</footer>
</Layout>
