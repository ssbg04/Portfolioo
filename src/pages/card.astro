---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings, getSocialLinks } from '../lib/data';
import VirtualBusinessCard from '../components/VirtualBusinessCard';
import ppDay from '../assets/pp-day.webp';

const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();

const avatarUrl = settings.heroImage || (ppDay as any).src || ppDay;

// Filter and sort links from Sanity for Links Directory
const rawLinks = socialLinks.length > 0
  ? socialLinks.filter((l) => l.showInLinksPage !== false && l.url && l.url !== '#')
  : [
      { platform: 'GitHub', url: 'https://github.com/ssbg04', icon: 'github', order: 1 },
      { platform: 'LinkedIn', url: 'https://www.linkedin.com/in/cris-charles-garcia/', icon: 'linkedin', order: 2 },
      { platform: 'Email', url: `mailto:${settings.email || 'crischarlesgarcia345@gmail.com'}`, icon: 'mail', order: 3 },
      { platform: 'Facebook', url: 'https://www.facebook.com/kristyarls345/', icon: 'facebook', order: 4 },
      { platform: 'TikTok', url: 'https://www.tiktok.com/@sisibigi', icon: 'tiktok', order: 5 },
    ];
const links = rawLinks.sort((a, b) => (a.order || 99) - (b.order || 99));

const formatDisplayUrl = (url: string) => {
  try {
    const parsed = new URL(url);
    return parsed.hostname.replace('www.', '') + parsed.pathname.replace(/\/$/, '');
  } catch {
    return url.replace(/^mailto:/, '');
  }
};

const getIconSvg = (platform: string) => {
  const p = platform.toLowerCase();
  if (p.includes('github')) {
    return '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>';
  }
  if (p.includes('linkedin')) {
    return '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>';
  }
  if (p.includes('facebook')) {
    return '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874V12h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>';
  }
  if (p.includes('tiktok')) {
    return '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.09-1.03-1.87-1.09-2.93-3.16-2.61-5.25.38-2.52 2.5-4.46 5.04-4.46.73 0 1.43.16 2.07.46.06.03.11.05.16.08v4.18c-1.38-.24-2.81-.19-4.16.14-1.12.28-2.12 1.05-2.67 2.06-.55 1.01-.58 2.22-.09 3.25.48 1.01 1.41 1.72 2.49 2.03 1.1.32 2.27.32 3.37.01.69-.2 1.34-.55 1.87-.99.53-.44.97-.99 1.25-1.61.28-.62.43-1.28.46-1.95.06-2.69.02-5.38.02-8.07z"/></svg>';
  }
  if (p.includes('mail') || p.includes('email')) {
    return '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>';
  }
  if (p.includes('twitter') || p.includes(' x')) {
    return '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>';
  }
  return '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>';
};
---

<Layout
  title={`Digital Business Card | ${settings.fullName}`}
  description={`Official digital business card and verified channels directory for ${settings.fullName}.`}
  canonicalURL="https://card.crischarles.com"
>
  <style is:global>
    body {
      padding-top: 0 !important;
    }
    #magnify-content {
      padding-top: 0 !important;
      padding-left: 0 !important;
    }
    .perspective-1200 {
      perspective: 1200px;
    }
    .preserve-3d {
      transform-style: preserve-3d;
    }
  </style>

  {/* Auto-Detect Theme Script for Business Card Page */}
  <script is:inline>
    (function() {
      function getSystemTheme() {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function applyThemeMode(mode) {
        var resolved = mode === 'system' ? getSystemTheme() : mode;
        if (resolved === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        var pillText = document.getElementById('theme-pill-text');
        var pillIcon = document.getElementById('theme-pill-icon');
        if (pillText && pillIcon) {
          if (mode === 'system') {
            pillIcon.textContent = '◐';
            pillText.textContent = 'AUTO (' + resolved + ')';
          } else if (mode === 'dark') {
            pillIcon.textContent = '☾';
            pillText.textContent = 'DARK';
          } else {
            pillIcon.textContent = '☼';
            pillText.textContent = 'LIGHT';
          }
        }
      }

      var currentMode = localStorage.getItem('theme') || 'system';
      applyThemeMode(currentMode);

      try {
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var changeHandler = function() {
          var stored = localStorage.getItem('theme');
          if (!stored || stored === 'system') {
            applyThemeMode('system');
          }
        };
        if (mq.addEventListener) {
          mq.addEventListener('change', changeHandler);
        } else if (mq.addListener) {
          mq.addListener(changeHandler);
        }
      } catch (e) {}

      document.addEventListener('DOMContentLoaded', function() {
        var btn = document.getElementById('theme-auto-pill');
        if (btn) {
          btn.addEventListener('click', function() {
            var stored = localStorage.getItem('theme') || 'system';
            var nextMode = 'system';
            if (stored === 'system') nextMode = 'light';
            else if (stored === 'light') nextMode = 'dark';
            else nextMode = 'system';

            localStorage.setItem('theme', nextMode);
            applyThemeMode(nextMode);
            window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: nextMode === 'system' ? getSystemTheme() : nextMode } }));
          });
        }
        applyThemeMode(localStorage.getItem('theme') || 'system');
      });

      document.addEventListener('astro:page-load', function() {
        applyThemeMode(localStorage.getItem('theme') || 'system');
      });
    })();
  </script>

  {/* Main Container — Landscape: 2-column (Left Card, Right Links) / Mobile: Top Card, Bottom Links */}
  <main class="min-h-screen py-8 sm:py-12 px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center relative">
    
    <div class="w-full max-w-5xl flex flex-col gap-6 sm:gap-8 relative z-10 bryl-entrance stagger-1 my-auto">

      {/* Top Header Bar: Back to Portfolio & Auto Theme Pill */}
      <div class="w-full flex items-center justify-between gap-2.5 pb-3 border-b border-border-custom">
        <a
          href="https://crischarles.com"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-muted-foreground-custom hover:text-foreground-custom transition-colors group"
        >
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          <span>Portfolio</span>
        </a>

        <div class="flex items-center gap-2.5">
          <span class="hidden sm:inline-block text-[11px] font-mono text-muted-foreground-custom">
            card.crischarles.com
          </span>
          {/* Interactive Auto-Detect Theme Pill */}
          <button
            id="theme-auto-pill"
            type="button"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-card-custom hover:bg-elevated-custom text-foreground-custom text-[10px] font-mono font-semibold border border-border-custom transition-all cursor-pointer shadow-xs active:scale-95"
            title="Auto-detects device theme. Tap to cycle: Auto → Light → Dark"
            aria-label="Theme Mode Toggle"
          >
            <span id="theme-pill-icon" class="text-[11px]">◐</span>
            <span id="theme-pill-text" class="tracking-wider uppercase">AUTO</span>
          </button>
        </div>
      </div>

      {/* Main Responsive Grid: Left Card & Right Links in Landscape; Mobile Stacks Top-to-Bottom */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        {/* Left Column (Desktop: Left, Mobile: Top): 3D Real Business Card + Quick Actions */}
        <div class="lg:col-span-7 flex flex-col items-center w-full">
          <VirtualBusinessCard
            settings={settings}
            avatarSrc={avatarUrl}
            client:load
          />
        </div>

        {/* Right Column (Desktop: Right, Mobile: Below Card): Official Channels from Sanity */}
        <div class="lg:col-span-5 flex flex-col gap-3.5 w-full">
          
          <div class="flex items-center justify-between pb-2 border-b border-border-custom">
            <div class="section-marker">
              <span class="section-marker-num">01 —</span>
              <span class="section-marker-title">official channels</span>
            </div>
            <span class="micro-label text-[10px] text-muted-foreground-custom font-mono">
              {links.length} verified
            </span>
          </div>

          {/* Social Links List */}
          <nav class="flex flex-col gap-2.5" aria-label="Official Links">
            {links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="bryl-card p-3 sm:p-3.5 flex items-center justify-between group cursor-pointer transition-all duration-300 hover:-translate-y-0.5 hover:border-border-strong hover:shadow-md"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-8 h-8 rounded-lg bg-foreground-custom/[0.04] border border-border-custom flex items-center justify-center text-foreground-custom shrink-0 group-hover:bg-foreground-custom group-hover:text-background-custom transition-all duration-200">
                    <Fragment set:html={getIconSvg(link.platform)} />
                  </div>

                  <div class="flex flex-col min-w-0">
                    <span class="text-xs sm:text-sm font-mono font-semibold text-foreground-custom leading-tight group-hover:underline">
                      {link.platform}
                    </span>
                    <span class="text-[10px] sm:text-[11px] font-mono text-muted-foreground-custom truncate leading-tight mt-0.5" title={link.url}>
                      {formatDisplayUrl(link.url)}
                    </span>
                  </div>
                </div>

                <span class="text-xs font-mono text-muted-foreground-custom group-hover:text-foreground-custom group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0 ml-2">
                  ↗
                </span>
              </a>
            ))}
          </nav>

          {/* Download CV / Resume Button */}
          {settings.resumeFile && (
            <a
              href={settings.resumeFile}
              target="_blank"
              rel="noopener noreferrer"
              class="bryl-card p-3 flex items-center justify-between border-dashed hover:border-solid hover:border-foreground-custom transition-all group mt-1"
            >
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-foreground-custom text-background-custom flex items-center justify-center font-mono text-xs font-bold shrink-0">
                  CV
                </div>
                <div class="flex flex-col">
                  <span class="text-xs font-mono font-semibold text-foreground-custom">Download Resume</span>
                  <span class="text-[10px] font-mono text-muted-foreground-custom">PDF Document</span>
                </div>
              </div>
              <span class="text-xs font-mono text-muted-foreground-custom group-hover:text-foreground-custom group-hover:translate-y-0.5 transition-transform">
                ↓
              </span>
            </a>
          )}

        </div>

      </div>

      {/* Minimal Footer Stamp */}
      <footer class="text-center pt-4 pb-2 border-t border-border-custom mt-2">
        <p class="micro-label text-[10px] text-muted-foreground-custom uppercase tracking-widest">
          &copy; {new Date().getFullYear()} {settings.fullName} · card.crischarles.com
        </p>
      </footer>

    </div>
  </main>
</Layout>
