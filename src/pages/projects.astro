---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ProjectsList from '../components/Projects';
import Footer from '../components/Footer';
import { getProjects, getSiteSettings, getSocialLinks } from '../lib/data';

const settings = await getSiteSettings();
const allProjects = await getProjects();
const socialLinks = await getSocialLinks();
---

<Layout 
	title={settings.seoTitle ? `Projects | ${settings.seoTitle}` : `Projects | ${settings.fullName}`} 
	description="View all full-stack development and AI projects developed by Cris Charles Garcia."
	image={settings.heroImage || settings.logoImage || '/logo.png'}
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} currentPath={Astro.url.pathname} client:load transition:persist="main-navbar" />

	<main class="flex-1 pt-4 sm:pt-8 pb-16">
		<div class="container mx-auto px-4 sm:px-6 max-w-6xl text-center mb-4 sm:mb-8">
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-heading tracking-tight text-foreground-custom">
				Projects & Software Development Work
			</h1>
			<p class="text-sm text-muted-foreground-custom mt-2 max-w-md mx-auto">Explore software systems, web applications, and development projects built by Cris Charles Garcia. This collection covers full-stack applications, information systems, AI-assisted tools, and other practical software projects developed across academic, personal, and open-source work.</p>
		</div>

		<ProjectsList initialProjects={allProjects} showArchiveLink={false} client:load />
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
