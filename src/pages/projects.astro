---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ProjectsList from '../components/Projects';
import Footer from '../components/Footer';
import { getProjects, getSiteSettings, getSocialLinks } from '../lib/data';

const settings = await getSiteSettings();
const allProjects = await getProjects();
const socialLinks = await getSocialLinks();
---

<Layout 
	title={settings.seoTitle ? `Projects | ${settings.seoTitle}` : `Projects | ${settings.fullName}`} 
	description="View all full-stack development and AI projects developed by Cris Charles Garcia."
	image={settings.heroImage || settings.logoImage || '/logo.png'}
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} client:load />

	<main class="flex-1 pt-6 sm:pt-10 pb-16">
		<div class="container mx-auto px-6 max-w-5xl text-center mb-12">
			<h1 class="text-4xl md:text-6xl font-bold font-heading mb-4 text-glow bg-clip-text text-transparent bg-gradient-to-r from-foreground-custom to-primary-custom">
				All Work
			</h1>
			<p class="text-muted-foreground-custom max-w-lg mx-auto">
				Explore the complete repository of my project work, filterable by technologies.
			</p>
		</div>

		<ProjectsList initialProjects={allProjects} showArchiveLink={false} client:load />
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
