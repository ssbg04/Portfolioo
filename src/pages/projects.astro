---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import ProjectsList from '../components/Projects';
import Footer from '../components/Footer';
import { getProjects, getSiteSettings, getSocialLinks } from '../lib/data';

const settings = await getSiteSettings();
const allProjects = await getProjects();
const socialLinks = await getSocialLinks();
---

<Layout 
	title={settings.seoTitle ? `Projects | ${settings.seoTitle}` : `Projects | ${settings.fullName}`} 
	description="View all software engineering systems, tools, and web applications developed by Cris Charles Garcia."
	image={settings.heroImage || settings.logoImage || '/logo.png'}
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} currentPath={Astro.url.pathname} client:load transition:persist="main-navbar" />

	<main class="flex-1 pt-6 sm:pt-10 pb-16">
		<div class="max-w-[56rem] mx-auto px-4 sm:px-6 mb-8 pb-5 border-b border-border-custom">
			<span class="section-marker mb-1 block">02 — archive</span>
			<h1 class="font-display text-3xl sm:text-4xl tracking-tight text-foreground-custom lowercase">
				software &amp; projects
			</h1>
			<p class="text-xs font-mono text-muted-foreground-custom mt-2">
				collection of institutional systems, developer utilities, and web applications
			</p>
		</div>

		<ProjectsList initialProjects={allProjects} showArchiveLink={false} sectionTag="all work" client:load />
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
