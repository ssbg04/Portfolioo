---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/data';

const settings = await getSiteSettings();
---

<Layout title={`404 - Not Found | ${settings.fullName}`} description="The page you are looking for does not exist.">
	<main class="min-h-screen flex flex-col items-center justify-center text-center px-4 relative z-10">
		<div class="bryl-card p-8 sm:p-12 max-w-[28rem] w-full text-center space-y-4">
			<div class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground-custom">
				route_error // 0x404
			</div>
			<div class="text-6xl sm:text-7xl font-mono font-bold tracking-tight text-foreground-custom">
				404
			</div>
			<h1 class="text-sm font-mono uppercase tracking-wider text-foreground-custom">
				page not found
			</h1>
			<p class="text-xs font-mono text-muted-foreground-custom leading-relaxed">
				the requested route does not exist in this registry or has been archived.
			</p>
			<div class="pt-2">
				<a
					href="/"
					class="bryl-btn-primary inline-flex items-center gap-2"
				>
					<span>←</span>
					<span>return home</span>
				</a>
			</div>
		</div>
	</main>
</Layout>
