---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import Projects from '../components/Projects';
import Skills from '../components/Skills';
import Certifications from '../components/Certifications';
import About from '../components/About';
import Testimonials from '../components/Testimonials';
import ContactForm from '../components/ContactForm';
import Footer from '../components/Footer';

import { 
	getSiteSettings, 
	getProjects, 
	getSkills, 
	getCertifications,
	getExperience, 
	getEducation,
	getTestimonials,
	getSocialLinks
} from '../lib/data';

// Server-side fetch from Sanity (with resilient fallbacks)
const settings = await getSiteSettings();
const featuredProjects = await getProjects(true);
const skills = await getSkills();
const certifications = await getCertifications(true);
const experience = await getExperience();
const education = await getEducation();
const testimonials = await getTestimonials();
const socialLinks = await getSocialLinks();
---

<Layout 
	title={settings.seoTitle || `${settings.fullName} | ${settings.title}`} 
	description={settings.seoDescription || settings.valueProposition}
	image={settings.heroImage || settings.logoImage || '/logo.png'}
	preloadImage={settings.heroImage}
>
	<!-- Navigation bar -->
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} currentPath={Astro.url.pathname} client:load transition:persist="main-navbar" />

	<!-- Main sections -->
	<main class="flex-1">
		<Hero 
			fullName={settings.fullName} 
			title={settings.title} 
			valueProposition={settings.valueProposition} 
			heroImage={settings.heroImage}
			heroImageNight={settings.heroImageNight}
			isAvailable={settings.isAvailable}
			availabilityStatus={settings.availabilityStatus}
			socialLinks={socialLinks}
			resumeFile={settings.resumeFile}
		/>

		<!-- 02. Flagship & Selected Projects -->
		<Projects initialProjects={featuredProjects} limit={3} client:visible />

		<!-- 03. Evidence-Backed Technical Skills -->
		<Skills skills={skills} client:visible />

		<!-- 04. Experience & Education -->
		<About settings={settings} experience={experience} education={education} isCompact={false} client:visible />
		
		<!-- 05. Verified Certifications -->
		<Certifications certifications={certifications} client:visible />
		
		<!-- 06. Client & Peer Testimonials (only when published) -->
		{testimonials && testimonials.length > 0 && (
			<Testimonials testimonials={testimonials} client:visible />
		)}
		
		<!-- 07. Contact & Outreach -->
		<ContactForm 
			socialLinks={socialLinks}
			contactHeading={settings.contactHeading}
			contactSubtitle={settings.contactSubtitle}
			email={settings.email}
			client:visible 
		/>
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:visible />
</Layout>
