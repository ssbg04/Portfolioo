---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings, getSocialLinks } from '../lib/data';

const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();
const resumeUrl = settings.resumeFile && settings.resumeFile !== '#' ? settings.resumeFile : '/CV-Cris-Charles-Garcia.pdf';
const downloadUrl = resumeUrl.includes('cdn.sanity.io') 
  ? `${resumeUrl}${resumeUrl.includes('?') ? '&' : '?'}dl=CV-Cris-Charles-Garcia.pdf`
  : resumeUrl;
---

<Layout title={`Under Development | ${settings.fullName}`} description="Cris Charles Garcia — Portfolio currently under development. Please check back later.">
  <main class="min-h-screen flex flex-col items-center justify-center p-4 relative z-10">
    <div class="w-full max-w-[28rem]">
      
      {/* Clean Minimalist Container */}
      <div class="bryl-card p-6 sm:p-8 flex flex-col gap-6">
        
        {/* Header: Logo + Identity */}
        <div class="flex items-center gap-3 pb-5 border-b border-border-custom">
          <img
            src={settings.logoImage || settings.heroImage || '/logo.png'}
            alt={settings.fullName}
            class="w-10 h-10 rounded-xl object-cover border border-border-custom"
            loading="eager"
            decoding="async"
          />
          <div>
            <h1 class="text-sm font-mono lowercase font-bold text-foreground-custom tracking-tight">
              {settings.fullName}
            </h1>
            <p class="text-xs font-mono text-muted-foreground-custom">
              {settings.title}
            </p>
          </div>
        </div>

        {/* Status + Core Message */}
        <div class="flex flex-col gap-3">
          <div class="inline-flex items-center gap-2 text-[10px] font-mono uppercase tracking-wider text-muted-foreground-custom">
            <span class="w-1.5 h-1.5 rounded-full bg-foreground-custom animate-pulse"></span>
            <span>status // maintenance</span>
          </div>

          <h2 class="text-xl font-mono lowercase font-bold text-foreground-custom tracking-tight">
            {settings.maintenanceTitle || 'system refinement in progress.'}
          </h2>

          <p class="text-xs font-mono text-muted-foreground-custom leading-relaxed">
            {settings.maintenanceMessage || 'The registry is currently being refined and updated. Direct channels and credentials remain active below.'}
          </p>
        </div>

        {/* Minimal Social Links */}
        <div class="pt-4 border-t border-border-custom flex flex-col gap-2.5">
          <span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground-custom">
            direct channels
          </span>

          <div class="flex flex-wrap gap-1.5">
            {socialLinks.map((link) => (
              <a
                key={link.platform}
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-2.5 py-1 rounded-md text-[11px] font-mono border border-border-custom text-foreground-custom hover:border-foreground-custom transition-colors"
              >
                {link.platform.toLowerCase()} ↗
              </a>
            ))}
          </div>
        </div>

        {/* Resume / CV Section */}
        <div class="pt-4 border-t border-border-custom flex flex-col gap-2.5">
          <span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground-custom">
            curriculum vitae
          </span>
          <div class="grid grid-cols-2 gap-2">
            <a
              href={resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bryl-btn-primary text-center"
            >
              view cv ↗
            </a>
            <a
              href={downloadUrl}
              download="CV-Cris-Charles-Garcia.pdf"
              class="bryl-btn-secondary text-center"
            >
              download ↓
            </a>
          </div>
        </div>

      </div>

      {/* Understated footer */}
      <p class="text-center text-[10px] font-mono text-muted-foreground-custom mt-6">
        &copy; {new Date().getFullYear()} {settings.fullName} // maintenance
      </p>

    </div>
  </main>
</Layout>
