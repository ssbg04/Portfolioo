---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings, getSocialLinks } from '../lib/data';

const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();

const getPlatformIcon = (platform: string) => {
  const p = platform.toLowerCase();
  if (p.includes('github')) {
    return `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`;
  }
  if (p.includes('facebook')) {
    return `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874V12h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`;
  }
  if (p.includes('tiktok')) {
    return `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.09-1.03-1.87-1.09-2.93-3.16-2.61-5.25.38-2.52 2.5-4.46 5.04-4.46.73 0 1.43.16 2.07.46.06.03.11.05.16.08v4.18c-1.38-.24-2.81-.19-4.16.14-1.12.28-2.12 1.05-2.67 2.06-.55 1.01-.58 2.22-.09 3.25.48 1.01 1.41 1.72 2.49 2.03 1.1.32 2.27.32 3.37.01.69-.2 1.34-.55 1.87-.99.53-.44.97-.99 1.25-1.61.28-.62.43-1.28.46-1.95.06-2.69.02-5.38.02-8.07z"/></svg>`;
  }
  if (p.includes('linkedin')) {
    return `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`;
  }
  return `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>`;
};
---

<Layout title={`Under Development | ${settings.fullName}`} description="The portfolio is currently undergoing active development and upgrades. Please check back soon!">
  <main class="min-h-screen flex flex-col items-center justify-center p-6 relative overflow-hidden bg-gradient-mesh">
    
    {/* Animated glowing orbs */}
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-24 left-1/4 w-96 h-96 rounded-full bg-primary-custom/10 blur-3xl animate-float"></div>
      <div class="absolute bottom-10 right-1/4 w-96 h-96 rounded-full bg-secondary-custom/10 blur-3xl animate-pulse-slow"></div>
    </div>

    <div class="w-full max-w-lg relative z-10">
      <div class="glass-card p-8 sm:p-12 rounded-[32px] border border-border-custom text-center shadow-2xl flex flex-col items-center">
        
        {/* Brand Avatar */}
        <div class="relative w-24 h-24 rounded-full p-1 bg-gradient-to-tr from-primary-custom to-secondary-custom mb-6 shadow-xl group">
          <img
            src="/logo.png"
            alt={settings.fullName}
            class="w-full h-full rounded-full object-cover shadow-inner group-hover:scale-105 transition-transform duration-300"
          />
          <span class="absolute bottom-0 right-0 w-6 h-6 rounded-full bg-amber-500 border-2 border-background-custom flex items-center justify-center text-white text-xs shadow-md">
            ⚡
          </span>
        </div>

        {/* Status Pill Badge */}
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-xs font-bold text-amber-600 dark:text-amber-400 mb-5 uppercase tracking-wider shadow-xs">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
          System Upgrade in Progress
        </div>

        {/* Main Heading */}
        <h1 class="text-3xl sm:text-4xl font-black font-heading text-foreground-custom mb-3 tracking-tight">
          Under Development
        </h1>

        <p class="text-lg sm:text-xl font-bold text-primary-custom mb-4 font-heading">
          Please come back later!
        </p>

        <p class="text-sm sm:text-base text-foreground-custom/80 dark:text-foreground-custom/85 leading-relaxed max-w-md mb-8">
          I am currently deploying significant enhancements, new features, and responsive optimizations to the portfolio. Everything will be back online shortly.
        </p>

        {/* Divider */}
        <div class="w-full h-px bg-border-custom/50 mb-8"></div>

        {/* Connect while waiting */}
        <div class="w-full flex flex-col items-center gap-4">
          <span class="text-xs font-bold uppercase tracking-widest text-muted-foreground-custom">
            Connect in the meantime
          </span>

          <div class="flex items-center justify-center gap-3 flex-wrap">
            {socialLinks.map((link) => (
              <a
                key={link.platform}
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="glass-card flex items-center gap-2.5 px-4 py-2.5 rounded-2xl text-xs font-semibold text-foreground-custom hover:text-primary-custom hover:border-primary-custom/40 transition-all duration-200 shadow-sm group"
                title={link.platform}
              >
                <span class="text-foreground-custom group-hover:text-primary-custom transition-colors" set:html={getPlatformIcon(link.platform)}></span>
                <span>{link.platform}</span>
              </a>
            ))}
          </div>
        </div>

      </div>

      {/* Footer copyright */}
      <p class="text-center text-xs text-muted-foreground-custom mt-8 font-medium">
        &copy; {new Date().getFullYear()} {settings.fullName}. All rights reserved.
      </p>
    </div>
  </main>
</Layout>
