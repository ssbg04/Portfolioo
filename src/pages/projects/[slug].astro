---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import { getProjects, getSiteSettings, getSocialLinks } from '../../lib/data';

export async function getStaticPaths() {
	const projects = await getProjects();

	return projects.map((project) => ({
		params: {
			slug: project.slug
		},
		props: {
			project
		}
	}));
}

const { project } = Astro.props;

const allProjects = await getProjects();
const currentIndex = allProjects.findIndex((p) => p.slug === project.slug);

const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();

// Adjacent projects for bottom navigation
const prevProject =
	currentIndex > 0 ? allProjects[currentIndex - 1] : null;

const nextProject =
	currentIndex < allProjects.length - 1
		? allProjects[currentIndex + 1]
		: null;
---

<Layout 
	title={`${project.title} | ${settings.fullName}`} 
	description={project.summary}
	image={project.coverImage || settings.heroImage || settings.logoImage || '/logo.png'}
	type="article"
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} currentPath="/projects" client:load transition:persist="main-navbar" />

	<main class="flex-1 pt-6 sm:pt-10 pb-20 relative">
		<div class="max-w-[56rem] mx-auto px-4 sm:px-6 relative z-10">
			
			{/* Top Navigation & Meta Breadcrumb */}
			<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
				<a 
					href="/projects" 
					class="inline-flex items-center gap-2 text-xs font-mono text-muted-foreground-custom hover:text-foreground-custom transition-colors group"
				>
					<span class="group-hover:-translate-x-1 transition-transform">←</span>
					<span>back to archive</span>
				</a>

				<div class="flex items-center gap-2">
					{project.category && (
						<span class="text-[10px] font-mono uppercase tracking-wider px-2.5 py-0.5 rounded-md border border-border-custom bg-muted-custom/30 text-muted-foreground-custom">
							{project.category}
						</span>
					)}
					{project.status && (
						<span class="text-[10px] font-mono uppercase tracking-wider px-2.5 py-0.5 rounded-md border border-border-custom bg-card-custom text-foreground-custom inline-flex items-center gap-1.5">
							<span class="w-1.5 h-1.5 rounded-full bg-foreground-custom animate-pulse" />
							{project.status}
						</span>
					)}
				</div>
			</div>

			{/* Project Hero Header */}
			<header class="mb-10 max-w-[42rem]">
				<div class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground-custom mb-3">
					case study // {project.category || 'engineering'}
				</div>
				<h1 class="text-3xl sm:text-5xl font-mono lowercase font-bold text-foreground-custom tracking-tight leading-[1.1] mb-6">
					{project.title}
				</h1>

				<p class="font-serif text-lg sm:text-xl text-muted-foreground-custom leading-relaxed mb-8">
					{project.summary}
				</p>

				{/* Primary Quick Action Buttons */}
				<div class="flex flex-wrap items-center gap-3">
					{project.liveUrl && (
						<a
							href={project.liveUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="bryl-btn-primary"
						>
							live demo ↗
						</a>
					)}

					{project.repositoryUrl && (
						<a
							href={project.repositoryUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="bryl-btn-secondary"
						>
							source code ↗
						</a>
					)}
				</div>
			</header>

			{/* Featured Hero Cover Image Viewport */}
			{project.coverImage && (
				<div class="relative aspect-[16/9] w-full rounded-2xl overflow-hidden border border-border-custom bg-muted-custom/20 mb-12 group">
					<img 
						src={project.coverImage} 
						alt={project.title}
						loading="eager"
						decoding="async"
						fetchpriority="high"
						class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
					/>
				</div>
			)}

			{/* Spread Multi-Column Responsive Layout */}
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
				
				{/* LEFT / MAIN COLUMN (8 cols): Overview, Highlights, Gallery */}
				<div class="lg:col-span-8 space-y-12">
					
					{/* Section: Overview / Description */}
					<section class="max-w-[42rem]">
						<div class="section-marker mb-4">
							<span class="section-marker-num">01 —</span>
							<span class="section-marker-title">overview</span>
						</div>
						<div class="font-serif text-base sm:text-lg text-muted-foreground-custom leading-relaxed space-y-4">
							<p>{project.description || project.summary}</p>
						</div>
					</section>

					{/* Section: Gallery Previews */}
					{project.gallery && project.gallery.length > 0 && (
						<section>
							<div class="section-marker mb-4">
								<span class="section-marker-num">02 —</span>
								<span class="section-marker-title">gallery</span>
							</div>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								{project.gallery.map((imgUrl, i) => (
									<div 
										key={i} 
										class="relative aspect-[16/10] rounded-xl overflow-hidden border border-border-custom bg-muted-custom/20 group"
									>
										<img 
											src={imgUrl} 
											alt={`${project.title} screenshot ${i + 1}`} 
											class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
											loading="lazy"
											decoding="async"
											fetchpriority="auto"
										/>
									</div>
								))}
							</div>
						</section>
					)}

				</div>

				{/* RIGHT / SIDEBAR COLUMN (4 cols): Sticky Specifications & Tech Stack */}
				<aside class="lg:col-span-4 space-y-4 lg:sticky lg:top-24">
					
					{/* Project Details Specifications Card */}
					<div class="bryl-card p-5 space-y-4">
						<h3 class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground-custom font-semibold">
							specifications
						</h3>

						<div class="divide-y divide-border-custom text-xs font-mono">
							{project.category && (
								<div class="flex items-center justify-between py-2">
									<span class="text-muted-foreground-custom">category</span>
									<span class="text-foreground-custom font-medium text-right">{project.category}</span>
								</div>
							)}

							{project.status && (
								<div class="flex items-center justify-between py-2">
									<span class="text-muted-foreground-custom">status</span>
									<span class="text-foreground-custom font-semibold">{project.status}</span>
								</div>
							)}

							{project.publishedAt && (
								<div class="flex items-center justify-between py-2">
									<span class="text-muted-foreground-custom">year</span>
									<span class="text-foreground-custom">{project.publishedAt}</span>
								</div>
							)}

							<div class="flex items-center justify-between py-2">
								<span class="text-muted-foreground-custom">deployment</span>
								<span class="text-foreground-custom">production</span>
							</div>
						</div>
					</div>

					{/* Technologies Used Card */}
					<div class="bryl-card p-5 space-y-3">
						<h3 class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground-custom font-semibold">
							stack
						</h3>
						<div class="flex flex-wrap gap-1.5">
							{project.technologies.map((t) => (
								<span
									key={t}
									class="px-2.5 py-1 rounded-md bg-muted-custom/30 border border-border-custom text-[11px] font-mono text-foreground-custom"
								>
									{t}
								</span>
							))}
						</div>
					</div>

				</aside>

			</div>

			{/* Bottom Adjacent Navigation Strip */}
			<div class="border-t border-border-custom mt-16 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
				{prevProject ? (
					<a
						href={`/projects/${prevProject.slug}`}
						class="inline-flex items-center gap-2 text-muted-foreground-custom hover:text-foreground-custom transition-colors group"
					>
						<span class="group-hover:-translate-x-1 transition-transform">←</span>
						<span>prev: <span class="text-foreground-custom font-semibold">{prevProject.title}</span></span>
					</a>
				) : (
					<div />
				)}

				<a
					href="/projects"
					class="px-3 py-1.5 rounded-md border border-border-custom text-muted-foreground-custom hover:text-foreground-custom hover:border-foreground-custom transition-all"
				>
					archive
				</a>

				{nextProject ? (
					<a
						href={`/projects/${nextProject.slug}`}
						class="inline-flex items-center gap-2 text-muted-foreground-custom hover:text-foreground-custom transition-colors group sm:ml-auto"
					>
						<span>next: <span class="text-foreground-custom font-semibold">{nextProject.title}</span></span>
						<span class="group-hover:translate-x-1 transition-transform">→</span>
					</a>
				) : (
					<div />
				)}
			</div>

		</div>
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
