---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import { getProjects, getSiteSettings, getSocialLinks } from '../../lib/data';

const { slug } = Astro.params;
const allProjects = await getProjects();
const project = allProjects.find(p => p.slug === slug);
const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();

if (!project) {
	return Astro.redirect('/404');
}
---

<Layout 
	title={`${project.title} | ${settings.fullName}`} 
	description={project.summary}
	image={project.coverImage || settings.heroImage || settings.logoImage || '/logo.png'}
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} client:load />

	<main class="flex-1 pt-32 pb-24 relative overflow-hidden">
		<!-- Background elements -->
		<div className="absolute inset-0 z-0 overflow-hidden pointer-events-none">
			<div className="absolute -top-40 left-1/4 w-[500px] h-[500px] rounded-full bg-primary-custom/5 blur-3xl" />
			<div className="absolute bottom-20 right-1/4 w-80 h-80 rounded-full bg-secondary-custom/5 blur-3xl" />
		</div>

		<div class="container mx-auto px-6 max-w-3xl relative z-10">
			<!-- Back to projects -->
			<a 
				href="/projects" 
				class="inline-flex items-center gap-1.5 text-xs font-bold text-muted-foreground-custom hover:text-primary-custom transition-colors mb-10"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
					<path strokeLinecap="round" strokeLinejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
				</svg>
				Back to projects
			</a>

			<article class="glass-card p-8 md:p-12 rounded-[32px] border border-border/20 shadow-2xl relative overflow-hidden">
				{/* Header banner */}
				<div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-primary-custom via-secondary-custom to-primary-custom" />
				
				<div class="flex items-center justify-between mb-4">
					<span class="text-[10px] uppercase tracking-widest font-bold text-primary-custom bg-primary-custom/10 px-3 py-1 rounded-full">
						Project Showcase
					</span>
					<span class="text-xs font-semibold text-muted-foreground-custom">
						Published: {project.publishedAt}
					</span>
				</div>

				<h1 class="text-3xl md:text-5xl font-bold font-heading mb-6 text-foreground-custom text-glow">
					{project.title}
				</h1>

				<p class="text-base md:text-lg font-medium text-muted-foreground-custom/95 leading-relaxed mb-8 border-l-2 border-primary-custom/30 pl-4 italic">
					{project.summary}
				</p>

				{/* Project Cover & Gallery */}
				{project.coverImage ? (
					<div class="aspect-video w-full rounded-2xl overflow-hidden border border-border-custom mb-10 shadow-lg relative group">
						<img 
							src={project.coverImage} 
							alt={project.title}
							class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-500"
						/>
						{project.status && (
							<div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/70 backdrop-blur-md text-xs font-mono text-emerald-400 flex items-center gap-1.5 shadow">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
								{project.status}
							</div>
						)}
					</div>
				) : (
					<div class="aspect-video w-full rounded-2xl bg-gradient-to-tr from-primary-custom/10 to-secondary-custom/10 border border-border/10 flex items-center justify-center p-6 mb-10 shadow-inner group overflow-hidden">
						<div class="text-center group-hover:scale-105 transition-transform duration-300">
							<div class="w-16 h-16 rounded-full bg-background-custom/80 flex items-center justify-center text-primary-custom mx-auto mb-4 border border-border/20 shadow">
								<svg class="w-8 h-8" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
									<path strokeLinecap="round" strokeLinejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m11.142 0L21.75 12l-4.179-2.25M12 21.75V2.25" />
								</svg>
							</div>
							<span class="text-xs font-semibold text-muted-foreground-custom/90">{project.title} Interface</span>
						</div>
					</div>
				)}

				{/* Gallery images if present */}
				{project.gallery && project.gallery.length > 0 && (
					<div class="mb-10">
						<h3 class="text-xs font-bold text-muted-foreground-custom uppercase tracking-wider mb-4">
							Project Gallery &amp; Previews
						</h3>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							{project.gallery.map((imgUrl, i) => (
								<div key={i} class="rounded-xl overflow-hidden border border-border-custom aspect-video shadow-xs">
									<img src={imgUrl} alt={`${project.title} screenshot ${i+1}`} class="w-full h-full object-cover" />
								</div>
							))}
						</div>
					</div>
				)}

				<div class="prose dark:prose-invert max-w-none text-sm md:text-base text-muted-foreground-custom/90 leading-relaxed mb-10">
					<h3 class="text-lg font-bold text-foreground-custom mb-3">Project Description</h3>
					<p>{project.description}</p>
				</div>

				{/* Tech Stack List */}
				<div class="mb-10 pt-6 border-t border-border/10">
					<h3 class="text-xs font-bold text-muted-foreground-custom uppercase tracking-wider mb-4">
						Technologies Employed
					</h3>
					<div class="flex flex-wrap gap-2">
						{project.technologies.map((t) => (
							<span
								key={t}
								class="text-xs font-semibold px-3.5 py-1.5 rounded-xl bg-muted-custom/45 text-muted-foreground-custom border border-border/10"
							>
								{t}
							</span>
						))}
					</div>
				</div>

				{/* Launch Links */}
				<div class="flex flex-col sm:flex-row items-center gap-4 pt-6 border-t border-border/10">
					{project.repositoryUrl && (
						<a
							href={project.repositoryUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="w-full sm:w-auto px-6 py-3.5 rounded-xl glass-card text-foreground-custom font-semibold text-xs border border-border/15 hover:bg-muted-custom/30 hover:scale-[1.01] active:scale-[0.99] transition-transform flex items-center justify-center gap-2"
						>
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
							</svg>
							Source Repository
						</a>
					)}
					{project.liveUrl && (
						<a
							href={project.liveUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-primary-custom text-primary-foreground font-semibold text-xs shadow-md hover:scale-[1.01] active:scale-[0.99] transition-transform flex items-center justify-center gap-2 sm:ml-auto"
						>
							Launch Live Demo
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
								<path strokeLinecap="round" strokeLinejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
							</svg>
						</a>
					)}
				</div>
			</article>
		</div>
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
