---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import { getProjects, getSiteSettings, getSocialLinks } from '../../lib/data';

export async function getStaticPaths() {
	const projects = await getProjects();

	return projects.map((project) => ({
		params: {
			slug: project.slug
		},
		props: {
			project
		}
	}));
}

const { project } = Astro.props;

const allProjects = await getProjects();
const currentIndex = allProjects.findIndex((p) => p.slug === project.slug);

const settings = await getSiteSettings();
const socialLinks = await getSocialLinks();

// Adjacent projects for bottom navigation
const prevProject =
	currentIndex > 0 ? allProjects[currentIndex - 1] : null;

const nextProject =
	currentIndex < allProjects.length - 1
		? allProjects[currentIndex + 1]
		: null;
---

<Layout 
	title={`${project.title} | ${settings.fullName}`} 
	description={project.summary}
	image={project.coverImage || settings.heroImage || settings.logoImage || '/logo.png'}
	type="article"
>
	<Navbar fullName={settings.fullName} logoImage={settings.logoImage} currentPath="/projects" client:load transition:persist="main-navbar" />

	<main class="flex-1 pt-3 sm:pt-8 pb-20 relative overflow-hidden">
		<!-- Subtle ambient background glows (no enclosing border) -->
		<div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
			<div class="absolute -top-32 left-1/3 w-[600px] h-[500px] rounded-full bg-primary-custom/5 blur-3xl"></div>
			<div class="absolute top-1/2 right-10 w-96 h-96 rounded-full bg-secondary-custom/5 blur-3xl"></div>
		</div>

		<div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
			
			{/* Top Navigation & Meta Breadcrumb */}
			<div class="flex flex-wrap items-center justify-between gap-4 mb-4 sm:mb-8">
				<a 
					href="/projects" 
					class="inline-flex items-center gap-2 text-xs font-mono font-medium text-muted-foreground-custom hover:text-foreground-custom transition-colors group"
				>
					<svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
						<path strokeLinecap="round" strokeLinejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
					</svg>
					Back to Projects
				</a>

				<div class="flex items-center gap-2.5">
					{project.category && (
						<span class="text-xs font-mono font-semibold text-primary-custom bg-primary-custom/10 border border-primary-custom/20 px-3 py-1 rounded-full">
							{project.category}
						</span>
					)}
					{project.status && (
						<span class="text-xs font-mono font-medium text-emerald-500 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full inline-flex items-center gap-1.5">
							<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
							{project.status}
						</span>
					)}
				</div>
			</div>

			{/* Project Hero Header */}
			<header class="mb-10">
				<h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold font-heading text-foreground-custom tracking-tight leading-[1.1] mb-6">
					{project.title}
				</h1>

				<p class="text-base sm:text-lg lg:text-xl text-muted-foreground-custom leading-relaxed max-w-4xl font-normal mb-8">
					{project.summary}
				</p>

				{/* Primary Quick Action Buttons */}
				<div class="flex flex-wrap items-center gap-3">
					{project.liveUrl && (
						<a
							href={project.liveUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary-custom text-white text-xs sm:text-sm font-semibold hover:bg-primary-custom/90 transition-all shadow-sm hover:shadow hover:-translate-y-0.5 active:translate-y-0"
						>
							Demo
							<svg class="w-4 h-4" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
								<path strokeLinecap="round" strokeLinejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
							</svg>
						</a>
					)}

					{project.repositoryUrl && (
						<a
							href={project.repositoryUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-border-custom hover:border-primary-custom/40 bg-card-custom text-foreground-custom text-xs sm:text-sm font-mono font-medium hover:text-primary-custom transition-all"
						>
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
							</svg>
							Code
						</a>
					)}
				</div>
			</header>

			{/* Featured Hero Cover Image Viewport */}
			{project.coverImage && (
				<div class="relative aspect-[16/9] w-full rounded-2xl md:rounded-3xl overflow-hidden border border-border-custom bg-muted-custom/20 mb-12 shadow-xl group">
					<img 
						src={project.coverImage} 
						alt={project.title}
						loading="eager"
						decoding="async"
						fetchpriority="high"
						class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-500"
					/>
					{project.status && (
						<div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-background-custom/85 backdrop-blur-md border border-border-custom text-xs font-mono font-medium text-emerald-500 dark:text-emerald-400 flex items-center gap-1.5 shadow-sm">
							<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
							{project.status}
						</div>
					)}
				</div>
			)}

			{/* Spread Multi-Column Responsive Layout */}
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
				
				{/* LEFT / MAIN COLUMN (8 cols): Overview, Highlights, Gallery */}
				<div class="lg:col-span-8 space-y-12">
					
					{/* Section: Overview / Description */}
					<section>
						<h2 class="text-xl sm:text-2xl font-bold font-heading text-foreground-custom mb-4 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-primary-custom" />
							Overview
						</h2>
						<div class="text-base sm:text-lg text-muted-foreground-custom leading-relaxed space-y-4 font-normal">
							<p>{project.description || project.summary}</p>
						</div>
					</section>

					{/* Section: System Architecture Diagram (Flagship Case Study for TIS Record Management System) */}
					{project.slug === 'tis-rms' && (
						<section class="space-y-4">
							<div class="flex items-center justify-between">
								<h2 class="text-xl sm:text-2xl font-bold font-heading text-foreground-custom flex items-center gap-2">
									<span class="w-2 h-2 rounded-full bg-primary-custom" />
									System Architecture &amp; Data Pipeline
								</h2>
								<span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-md bg-primary-custom/10 text-primary-custom border border-primary-custom/20">
									SEC_01 // ARCHITECTURE
								</span>
							</div>

							<div class="bento-card p-4 sm:p-6 rounded-2xl border border-border-custom bg-card-custom/80 shadow-sm overflow-hidden">
								<div class="w-full overflow-x-auto pb-2">
									<svg viewBox="0 0 840 220" class="w-full min-w-[700px] h-auto text-foreground-custom" fill="none">
										{/* Connection Lines with Animated Pulses */}
										<path d="M 160 110 L 250 110" stroke="currentColor" stroke-opacity="0.3" stroke-width="2" stroke-dasharray="4 4" />
										<path d="M 390 110 L 480 110" stroke="currentColor" stroke-opacity="0.3" stroke-width="2" stroke-dasharray="4 4" />
										<path d="M 620 110 L 710 110" stroke="currentColor" stroke-opacity="0.3" stroke-width="2" stroke-dasharray="4 4" />

										{/* Node 1: Client Layer */}
										<g transform="translate(20, 50)">
											<rect width="140" height="120" rx="14" class="fill-card-custom stroke-border-custom hover:stroke-primary-custom transition-all" stroke-width="1.5" />
											<rect x="12" y="14" width="28" height="28" rx="6" class="fill-primary-custom/15 text-primary-custom" />
											<text x="26" y="32" text-anchor="middle" font-family="monospace" font-size="12" font-weight="bold" fill="currentColor">01</text>
											<text x="14" y="66" font-family="sans-serif" font-size="13" font-weight="bold" fill="currentColor">Client Apps</text>
											<text x="14" y="84" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">Flutter Mobile</text>
											<text x="14" y="98" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">C# WPF Desktop</text>
											<text x="14" y="112" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">Role-Based UI</text>
										</g>

										{/* Node 2: Local Cache & Offline Sync */}
										<g transform="translate(250, 50)">
											<rect width="140" height="120" rx="14" class="fill-card-custom stroke-border-custom hover:stroke-primary-custom transition-all" stroke-width="1.5" />
											<rect x="12" y="14" width="28" height="28" rx="6" class="fill-emerald-500/15 text-emerald-500" />
											<text x="26" y="32" text-anchor="middle" font-family="monospace" font-size="12" font-weight="bold" fill="currentColor">02</text>
											<text x="14" y="66" font-family="sans-serif" font-size="13" font-weight="bold" fill="currentColor">Local Storage</text>
											<text x="14" y="84" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">SQLite Engine</text>
											<text x="14" y="98" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">Offline-First Cache</text>
											<text x="14" y="112" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">Instant Read/Write</text>
										</g>

										{/* Node 3: OCR & Document Processing Pipeline */}
										<g transform="translate(480, 50)">
											<rect width="140" height="120" rx="14" class="fill-card-custom stroke-border-custom hover:stroke-primary-custom transition-all" stroke-width="1.5" />
											<rect x="12" y="14" width="28" height="28" rx="6" class="fill-primary-custom/15 text-primary-custom" />
											<text x="26" y="32" text-anchor="middle" font-family="monospace" font-size="12" font-weight="bold" fill="currentColor">03</text>
											<text x="14" y="66" font-family="sans-serif" font-size="13" font-weight="bold" fill="currentColor">Backend &amp; OCR</text>
											<text x="14" y="84" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">Node.js Express</text>
											<text x="14" y="98" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">Tesseract OCR</text>
											<text x="14" y="112" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">Ghostscript PDF</text>
										</g>

										{/* Node 4: Secure Edge & Central Database */}
										<g transform="translate(710, 50)">
											<rect width="120" height="120" rx="14" class="fill-card-custom stroke-border-custom hover:stroke-primary-custom transition-all" stroke-width="1.5" />
											<rect x="12" y="14" width="28" height="28" rx="6" class="fill-amber-500/15 text-amber-500" />
											<text x="26" y="32" text-anchor="middle" font-family="monospace" font-size="12" font-weight="bold" fill="currentColor">04</text>
											<text x="14" y="66" font-family="sans-serif" font-size="13" font-weight="bold" fill="currentColor">Edge &amp; Sync</text>
											<text x="14" y="84" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">Cloudflare Tunnel</text>
											<text x="14" y="98" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">Encrypted Tunnels</text>
											<text x="14" y="112" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">MySQL Cluster</text>
										</g>
									</svg>
								</div>
								<p class="text-xs font-mono text-muted-foreground-custom mt-3 pt-3 border-t border-border-custom/50 flex items-center justify-between">
									<span>Pipeline: Client Capture → Local Offline SQLite → Automated OCR Indexing → Encrypted Cloudflare Sync</span>
									<span class="text-primary-custom font-semibold">100% AIR-GAPPED READY</span>
								</p>
							</div>
						</section>
					)}

					{/* Section: Key Highlights & Features */}
					{project.highlights && project.highlights.length > 0 && (
						<section>
							<h2 class="text-xl sm:text-2xl font-bold font-heading text-foreground-custom mb-6 flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-primary-custom" />
								Key Highlights
							</h2>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								{project.highlights.map((highlight) => (
									<div 
										key={highlight}
										class="p-4 sm:p-5 rounded-2xl border border-border-custom bg-card-custom hover:border-primary-custom/40 transition-all flex items-start gap-3.5 shadow-xs"
									>
										<div class="w-6 h-6 rounded-lg bg-primary-custom/10 text-primary-custom flex items-center justify-center flex-shrink-0 mt-0.5">
											<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
												<path strokeLinecap="round" strokeLinejoin="round" d="m4.5 12.75 6 6 9-13.5" />
											</svg>
										</div>
										<div>
											<p class="text-sm font-semibold text-foreground-custom leading-snug">
												{highlight}
											</p>
										</div>
									</div>
								))}
							</div>
						</section>
					)}

					{/* Section: Gallery Previews */}
					{project.gallery && project.gallery.length > 0 && (
						<section>
							<h2 class="text-xl sm:text-2xl font-bold font-heading text-foreground-custom mb-6 flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-primary-custom" />
								Gallery &amp; Screenshots
							</h2>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								{project.gallery.map((imgUrl, i) => (
									<div 
										key={i} 
										class="relative aspect-[16/10] rounded-2xl overflow-hidden border border-border-custom bg-muted-custom/20 shadow-sm group"
									>
										<img 
											src={imgUrl} 
											alt={`${project.title} screenshot ${i + 1}`} 
											class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
											loading="lazy"
											decoding="async"
											fetchpriority="auto"
										/>
									</div>
								))}
							</div>
						</section>
					)}

				</div>

				{/* RIGHT / SIDEBAR COLUMN (4 cols): Sticky Specifications & Tech Stack */}
				<aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
					
					{/* Project Details Specifications Card */}
					<div class="bento-card p-6 border border-border-custom space-y-5">
						<h3 class="text-xs font-mono uppercase tracking-wider text-muted-foreground-custom font-semibold">
							Project Details
						</h3>

						<div class="divide-y divide-border-custom/50 text-sm">
							{project.category && (
								<div class="flex items-center justify-between py-2.5">
									<span class="text-muted-foreground-custom text-xs font-mono">Category</span>
									<span class="text-foreground-custom font-medium text-xs text-right">{project.category}</span>
								</div>
							)}

							{project.status && (
								<div class="flex items-center justify-between py-2.5">
									<span class="text-muted-foreground-custom text-xs font-mono">Status</span>
									<span class="text-emerald-500 dark:text-emerald-400 font-mono text-xs font-semibold">{project.status}</span>
								</div>
							)}

							{project.publishedAt && (
								<div class="flex items-center justify-between py-2.5">
									<span class="text-muted-foreground-custom text-xs font-mono">Year</span>
									<span class="text-foreground-custom font-mono text-xs">{project.publishedAt}</span>
								</div>
							)}

							<div class="flex items-center justify-between py-2.5">
								<span class="text-muted-foreground-custom text-xs font-mono">Type</span>
								<span class="text-foreground-custom font-medium text-xs">Software Application</span>
							</div>
						</div>
					</div>

					{/* Technologies Used Card */}
					<div class="bento-card p-6 border border-border-custom space-y-4">
						<h3 class="text-xs font-mono uppercase tracking-wider text-muted-foreground-custom font-semibold">
							Technologies Used
						</h3>
						<div class="flex flex-wrap gap-2">
							{project.technologies.map((t) => (
								<span
									key={t}
									class="px-3 py-1.5 rounded-lg bg-muted-custom/40 border border-border-custom text-xs font-mono font-medium text-foreground-custom hover:border-primary-custom/40 transition-colors"
								>
									{t}
								</span>
							))}
						</div>
					</div>



				</aside>

			</div>

			{/* Bottom Adjacent Navigation Strip */}
			<div class="border-t border-border-custom mt-16 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
				{prevProject ? (
					<a
						href={`/projects/${prevProject.slug}`}
						class="inline-flex items-center gap-2 text-xs font-mono text-muted-foreground-custom hover:text-foreground-custom transition-colors group"
					>
						<svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
							<path strokeLinecap="round" strokeLinejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
						</svg>
						<span>Previous Project: <strong class="text-foreground-custom font-semibold">{prevProject.title}</strong></span>
					</a>
				) : (
					<div />
				)}

				<a
					href="/projects"
					class="px-4 py-2 rounded-xl bg-card-custom border border-border-custom hover:border-primary-custom/40 text-xs font-mono font-medium text-muted-foreground-custom hover:text-foreground-custom transition-all"
				>
					Back to Projects
				</a>

				{nextProject ? (
					<a
						href={`/projects/${nextProject.slug}`}
						class="inline-flex items-center gap-2 text-xs font-mono text-muted-foreground-custom hover:text-foreground-custom transition-colors group sm:ml-auto"
					>
						<span>Next Project: <strong class="text-foreground-custom font-semibold">{nextProject.title}</strong></span>
						<svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
							<path strokeLinecap="round" strokeLinejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
						</svg>
					</a>
				) : (
					<div />
				)}
			</div>

		</div>
	</main>

	<Footer fullName={settings.fullName} socialLinks={socialLinks} client:load />
</Layout>
