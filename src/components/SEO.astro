---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
}

const {
  title = 'Cris Charles Garcia | Full-Stack Developer & Software Engineer',
  description = 'Personal portfolio of Cris Charles Garcia — Full-Stack Developer specializing in modern web applications, Astro, React, TypeScript, Cloud solutions, and AI assistant integration.',
  image = '/logo.png',
  type = 'website',
  publishedTime,
} = Astro.props;

const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://crischarles.com';
const normalizedPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalURL =
  Astro.props.canonicalURL ||
  new URL(normalizedPath, siteOrigin).href;

const imagePath = image.startsWith('http')
  ? image
  : image.startsWith('/')
    ? image
    : `/${image}`;

const socialImageURL = new URL(imagePath, siteOrigin).href;

const isIndexablePage =
  !Astro.url.pathname.startsWith('/api/') &&
  !Astro.url.pathname.startsWith('/maintenance') &&
  !Astro.url.pathname.startsWith('/_astro') &&
  !Astro.url.pathname.startsWith('/_image');

const robotsValue = isIndexablePage
  ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
  : 'noindex, nofollow';

const socialProfiles = [
  'https://github.com/ssbg04',
  'https://www.facebook.com/kristyarls345/',
  'https://www.tiktok.com/@sisibigi',
  'https://crischarles.com',
];

// Navigation structure for Google Organic Sitelinks
const navigationElements = [
  {
    name: 'Projects',
    description: 'Explore full-stack software applications, information systems, and developer projects built by Cris Charles Garcia.',
    path: '/projects'
  },
  {
    name: 'About',
    description: "Learn more about Cris Charles Garcia's professional history, technical expertise, education, and developer biography.",
    path: '/about'
  },
  {
    name: 'Certifications',
    description: 'Verified credentials and certifications earned by Cris Charles Garcia from Cisco and other industry-recognized programs.',
    path: '/certifications'
  },
  {
    name: 'Gallery',
    description: 'Visual showcase and photo archive of project milestones, developer activities, and academic experiences.',
    path: '/gallery'
  },
  {
    name: 'Contact',
    description: 'Get in touch with Cris Charles Garcia for development inquiries, consulting, or project collaborations.',
    path: '/contact'
  }
];

const pathSegments = normalizedPath.split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0 ? {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteOrigin
    },
    ...pathSegments.map((seg, idx) => ({
      "@type": "ListItem",
      "position": idx + 2,
      "name": seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' '),
      "item": `${siteOrigin}/${pathSegments.slice(0, idx + 1).join('/')}`
    }))
  ]
} : null;

// JSON-LD Structured Data Schema (Person, WebSite, SiteNavigation, Breadcrumbs)
const schemaGraph: any[] = [
  {
    "@type": "WebSite",
    "@id": `${siteOrigin}/#website`,
    "url": siteOrigin,
    "name": "Cris Charles Garcia",
    "alternateName": ["Cris Charles", "Cris Charles Garcia Portfolio"],
    "description": description,
    "publisher": {
      "@id": `${siteOrigin}/#person`
    },
    "inLanguage": "en-US",
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${siteOrigin}/?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@type": "Person",
    "@id": `${siteOrigin}/#person`,
    "name": "Cris Charles Garcia",
    "url": siteOrigin,
    "image": socialImageURL,
    "jobTitle": "Full-Stack Developer & Software Engineer",
    "description": description,
    "sameAs": socialProfiles,
    "knowsAbout": [
      "Web Development",
      "React",
      "Astro",
      "TypeScript",
      "Node.js",
      "PHP",
      "MySQL",
      "Cloud Architecture",
      "Sanity CMS",
      "Tailwind CSS",
      "Artificial Intelligence"
    ]
  },
  {
    "@type": "ItemList",
    "@id": `${siteOrigin}/#navigation`,
    "name": "Site Navigation",
    "itemListElement": navigationElements.map((item, index) => ({
      "@type": "SiteNavigationElement",
      "position": index + 1,
      "name": item.name,
      "description": item.description,
      "url": `${siteOrigin}${item.path}`
    }))
  },
  {
    "@type": "ProfilePage",
    "@id": canonicalURL,
    "url": canonicalURL,
    "name": title,
    "isPartOf": {
      "@id": `${siteOrigin}/#website`
    },
    "mainEntity": {
      "@id": `${siteOrigin}/#person`
    }
  }
];

if (breadcrumbSchema) {
  schemaGraph.push(breadcrumbSchema);
}

const schemaData = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Cris Charles Garcia" />
<meta name="robots" content={robotsValue} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:alt" content="Cris Charles Garcia portfolio preview" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Cris Charles Garcia" />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />
<meta property="twitter:image:alt" content="Cris Charles Garcia portfolio preview" />
<meta name="twitter:creator" content="@CrisCharles" />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
